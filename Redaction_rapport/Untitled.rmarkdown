## Matrice de corrélation entre les variables d'engagement familial {#matcor .unnumbered}

```{r, echo = FALSE}
#| label: fig-matcor
#| fig-cap: "Le soutien familial est plus prononcé lorsque certains sujets de discussions sur l'école sont plus réguliers aux yeux des élèves"

bdd <- readRDS("~nathan/ENSAI/1A/BDD_ProjetStat1A.rds")
df_encour <- bdd %>%
  drop_na(LANGTEST_PAQ) %>% 
  select(ST353Q01JA, WB163Q01HA, FAMSUP, PA003Q11JA, ST300Q04JA,ST300Q07JA, PA003Q01TA, ST300Q01JA, ST300Q09JA, ST353Q05JA)
df_encour <- rename(df_encour,
                    pa_imp_fin_sec = PA003Q11JA,
                    pa_enf_sen_sort_ecole = PA003Q01TA,
                    st_ecole_se_passe_b = ST300Q01JA,
                    st_enc_bonnes_notes = ST300Q07JA,
                    st_imp_fin_sec = ST300Q04JA,
                    famsup = FAMSUP,
                    st_sco_future = ST300Q09JA,
                    wb_aides_plus_possible = WB163Q01HA,
                    st_aides_devoirs = ST353Q01JA,
                    st_verif_tr_covid = ST353Q05JA
                    )
matcor <- cor(df_encour, use = "pairwise.complete.obs")
?cor
corrplot(matcor, type = "upper", order = "AOE", tl.col = "black", tl.srt = 45)
